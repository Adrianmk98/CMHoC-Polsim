# Copy this file to .env for local development (no GCP account, no Docker needed).
# Run `python manage.py runserver` after filling this in.

# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=generate-a-strong-random-key-here

DEBUG=True

# Use local SQLite instead of Postgres.
USE_SQLITE=True

ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Off by default so dev doesn't need Ollama/Vertex running. Set True + run
# `ollama serve` (and pull a model) to test NPCs locally.
NPCS_ENABLED=False
NPC_LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Leave blank: with no bucket configured, media (avatars, bill/constitution
# PDFs) is written to the local media/ folder instead of Google Cloud Storage.
GS_BUCKET_NAME=
GS_PROJECT_ID=
