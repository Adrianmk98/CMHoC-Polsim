# Copy this file to .env and fill in your values before running docker compose

# Generate a strong random key, e.g.: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=generate-a-strong-random-key-here

# Set to False in production
DEBUG=False

# Database password (choose something strong)
DB_PASSWORD=choose-a-strong-password

# Comma-separated list of hostnames/IPs that can access the app
# Add your public domain here (e.g. the one routed through your named Cloudflare Tunnel)
ALLOWED_HOSTS=localhost,127.0.0.1,cmhoc.yourdomain.com

# Comma-separated list of trusted origins for CSRF protection
CSRF_TRUSTED_ORIGINS=https://cmhoc.yourdomain.com

# Set to False to disable all NPC activity without removing NPC accounts
NPCS_ENABLED=True

# NPC LLM backend: 'ollama' for local dev, 'vertex' in production (GCP)
NPC_LLM_BACKEND=ollama

# Local Ollama server powering AI NPCs (run `ollama serve` and `ollama pull <model>` first)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Vertex AI (used when NPC_LLM_BACKEND=vertex) - auth comes from the GCE instance's
# attached service account, no key file needed
VERTEX_PROJECT_ID=your-gcp-project-id
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-flash-lite

# Cloud SQL instance connection name (format PROJECT:REGION:INSTANCE), used by the
# cloud-sql-proxy sidecar in docker-compose.yml when deployed to GCP
CLOUD_SQL_CONNECTION_NAME=your-project:us-central1:cmhoc-db

# Cloudflare named Tunnel token, from `cloudflared tunnel token <tunnel-name>`,
# used by the cloudflared sidecar in docker-compose.yml to expose the app publicly
TUNNEL_TOKEN=your-cloudflared-tunnel-token
